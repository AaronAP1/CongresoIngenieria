          <a href="inscripcion.html" class="btn btn-primary">Quiero inscribirme</a>
          <a href="ejes-tematicos.html" class="btn btn-outline">Ver ejes temáticos</a>
        </div>

        <div class="countdown" data-countdown aria-label="Cuenta regresiva al 5 de julio de 2027">
          <div class="unit"><span class="num" data-days>00</span><span class="label">Días</span></div>
          <div class="unit"><span class="num" data-hours>00</span><span class="label">Horas</span></div>
