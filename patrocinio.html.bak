  <div class="container">
    <a href="index.html" class="brand-lockup" aria-label="I Congreso Nacional de Ingeniería — Colegio de Ingenieros del Perú">
      <span class="plate"><img src="assets/img/logo-conacip.png" alt="I Congreso Nacional de Ingeniería — CONACIP Perú 2027"></span>
      <span class="rule" aria-hidden="true"></span>
      <img src="assets/img/logo-cip-seal.png" alt="Colegio de Ingenieros del Perú" class="seal">
